# Seed script için gereken ek değişkenler
# Bu değerleri .env dosyana EKLE (üzerine yazma)
#
# SUPABASE_SERVICE_KEY nereden alınır:
#   Supabase Dashboard → Projen → Settings → API
#   → "service_role" key'i kopyala (secret — kimseyle paylaşma)
#
# SEED_ORGANIZER_ID nereden alınır:
#   Supabase Dashboard → Projen → Authentication → Users
#   → Kendi hesabına tıkla → User UID'yi kopyala
#   (önce telefon numaranla kayıt olmuş olman lazım)

SUPABASE_SERVICE_KEY=buraya_service_role_key_yapistir
SEED_ORGANIZER_ID=buraya_kendi_user_uuid_yapistir
